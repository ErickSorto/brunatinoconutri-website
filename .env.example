# Copy to .env.local. Never put these secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3011
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Optional additional calendars whose busy events should block availability.
GOOGLE_BUSY_CALENDAR_IDS=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Bruna's licensed Zoom user ID or email, belonging to this account.
ZOOM_USER_ID=
# Distributed slot locks and request deduplication for serverless deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Existing site's weekday hours, with DST-aware Eastern time. Confirm with Bruna.
BOOKING_TIMEZONE=America/New_York
BOOKING_START_HOUR=8
BOOKING_END_HOUR=18
BOOKING_LEAD_HOURS=24
